# The web panel binds to localhost by default. Use 0.0.0.0:8080 only inside
# a container or on a trusted private network.
PANEL_ADDR=127.0.0.1:8080
# Required. PAL CTRL will not start when this is empty.
PANEL_PASSWORD=replace-with-a-long-random-password
PANEL_SECURE_COOKIES=false

# Set true to explore the complete interface without a running server.
PALWORLD_MOCK=true

# Palworld management endpoints must stay private.
PALWORLD_REST_URL=http://127.0.0.1:8212
PALWORLD_ADMIN_USER=admin
PALWORLD_ADMIN_PASSWORD=1234
PALWORLD_RCON_ADDR=127.0.0.1:25575
PALWORLD_RCON_PASSWORD=1234

# The one Docker container and Compose service managed by this panel.
PALWORLD_CONTAINER=palworld
PALWORLD_COMPOSE_DIR=
PALWORLD_COMPOSE_SERVICE=palworld

# The live Saved directory is read only to PAL CTRL. Backups are written
# to a separate directory.
PALWORLD_SAVE_DIR=
PALWORLD_BACKUP_DIR=./backups
# Mount only the Palworld configuration directory read/write and point this
# value at PalWorldSettings.ini inside the panel container.
PALWORLD_SETTINGS_PATH=
PALWORLD_SETTINGS_STATE_DIR=./backups/settings

METRICS_INTERVAL=30s

# Low-rate unprivileged UDP DNS probes. Set an empty value to disable.
NETWORK_PROBE_TARGETS=1.1.1.1:53,8.8.8.8:53
NETWORK_PROBE_INTERVAL=5s
NETWORK_PROBE_TIMEOUT=2s
NETWORK_PROBE_WINDOW=20
NETWORK_DEGRADED_LOSS=5
NETWORK_CRITICAL_LOSS=20

# One human-readable CSV file per calendar day. The default directory lives
# inside PALWORLD_BACKUP_DIR so it uses the same persistent volume.
REPORT_DIR=./backups/reports
REPORT_RETENTION_DAYS=30
REPORT_TIMEZONE=UTC

PALWORLD_SHUTDOWN_WAIT=15
PALWORLD_SHUTDOWN_MESSAGE=Server is shutting down. See you soon.
